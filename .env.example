# Kopyala: .env  (Git dışında kalır). Değerler yalnızca yerel geliştirme içindir; gerçek parola yazmayın.
POSTGRES_DB=geomosk
POSTGRES_USER=geomosk
POSTGRES_PASSWORD=geomosk_dev
# API'nin kullandığı kısıtlı rol (geomosk_app) parolası
GEOMOSK_APP_PASSWORD=geomosk_app_dev
# Host'tan import (npm run import:load) için şema sahibi bağlantısı
GEOMOSK_IMPORT_DATABASE_URL=postgres://geomosk:geomosk_dev@localhost:5432/geomosk

# Host portları (127.0.0.1'e bağlanır)
DB_PORT=5432
API_PORT=5080
WEB_PORT=8080

# Frontend (Vite) — boş bırakılırsa istekler aynı origin'e /api olarak gider.
VITE_API_BASE_URL=
# Vite dev sunucusunun /api isteklerini aktaracağı yerel API adresi
VITE_DEV_API_PROXY=http://localhost:5080
